# ==========================================
# EcoSankalan — .gitignore
# ==========================================

# ── Environment & Secrets ──────────────────
# NEVER commit .env — it contains API keys, DB passwords, JWT secrets
.env
.env.*
!.env.example

# ── Node.js ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
pnpm-debug.log*

# ── Build outputs ─────────────────────────
dist/
build/
.next/
out/
.vite/
.cache/

# ── Testing ───────────────────────────────
coverage/
.nyc_output/

# ── Logs ──────────────────────────────────
logs/
*.log
*.pid
*.pid.lock

# ── OS files ──────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE & Editor ──────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.history/

# ── Vercel ────────────────────────────────
.vercel

# ── Uploads (local dev only) ──────────────
uploads/
temp/
tmp/

# ── MongoDB dump (never commit raw DB data) ──
*.dump
dump/

# ── Local credentials & certificates ──────
*.pem
*.key
*.crt
