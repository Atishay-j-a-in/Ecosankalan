# ============================================================
# EcoSankalan — Environment Variables Template
# CPVS-STP 2025-26(E) | Project ID: STP2025-26(E)CSE(M)VivekAyush(2024UCS1573)
# ============================================================
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to Git — it's in .gitignore
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas (Atishay fills this in) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/ecosankalan?retryWrites=true&w=majority

# --- Auth (Appwrite — JWT removed) ---
# Backend verifies Appwrite JWTs server-side via node-appwrite.
# Google OAuth is configured in the Appwrite console, not here.
# Admin bootstrap: comma-separated emails promoted to admin on /auth/sync.
ADMIN_EMAILS=guest@ecosankalan.app
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-server-api-key
# Frontend guest judge login (frontend/.env): VITE_GUEST_EMAIL must be an
# address listed in ADMIN_EMAILS above; VITE_GUEST_PASSWORD is its Appwrite
# password. Create the user in the Appwrite console first.

# --- OTP via MSG91 (Month 2 — leave blank for now) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=ECOSNK

# --- Google Gemini API (Month 3 — ₹3,000 budget activates then) ---
GEMINI_API_KEY=

# --- Razorpay (Month 5) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase FCM (Month 4) ---
FIREBASE_SERVER_KEY=

# --- Rate Limiting (60/min) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- CORS ---
# In production, replace * with your actual frontend URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
